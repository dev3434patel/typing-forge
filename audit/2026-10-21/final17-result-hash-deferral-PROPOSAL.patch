diff --git a/src/lib/final-result-yield.ts b/src/lib/final-result-yield.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/final-result-yield.ts
@@ -0,0 +1,41 @@
+/** Give a visible result one bounded paint opportunity before nonessential hashing.
+ * Only callers holding a factory-proven immutable final result may use this yield.
+ * This schedules work; it does not guarantee a paint or unload durability.
+ */
+export function yieldBeforeFinalResultHash(): Promise<void> {
+  if (typeof window === 'undefined' || typeof document === 'undefined' || document.visibilityState !== 'visible') return Promise.resolve();
+  return new Promise(resolve => {
+    let settled = false;
+    let frame: number | undefined;
+    let task: number | undefined;
+    let deadline: number | undefined;
+    const finish = () => {
+      if (settled) return;
+      settled = true;
+      if (frame !== undefined) window.cancelAnimationFrame(frame);
+      if (task !== undefined) window.clearTimeout(task);
+      if (deadline !== undefined) window.clearTimeout(deadline);
+      window.removeEventListener('pagehide', finish);
+      document.removeEventListener('visibilitychange', visibilityChanged);
+      resolve();
+    };
+    const visibilityChanged = () => {
+      if (document.visibilityState !== 'visible') finish();
+    };
+    window.addEventListener('pagehide', finish, { once: true });
+    document.addEventListener('visibilitychange', visibilityChanged);
+    deadline = window.setTimeout(finish, 50);
+    if (typeof window.requestAnimationFrame !== 'function' || typeof window.cancelAnimationFrame !== 'function') {
+      task = window.setTimeout(finish, 0);
+      return;
+    }
+    try {
+      frame = window.requestAnimationFrame(() => {
+        frame = undefined;
+        task = window.setTimeout(finish, 0);
+      });
+    } catch {
+      finish();
+    }
+  });
+}
