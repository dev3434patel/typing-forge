+/** Alignment owns flat primitive leaves; retain publication immutability without
+ * allocating Object.values arrays and recursive closures for each slot.
+ * Keep generic deep freezing for configuration and independently replayed results.
+ */
+function freezePresentationAlignment(value: Alignment): Alignment {
+  for (let index = 0; index < value.characters.length; index++) Object.freeze(value.characters[index]);
+  Object.freeze(value.characters);
+  Object.freeze(value.mapping);
+  for (let index = 0; index < value.words.length; index++) Object.freeze(value.words[index]);
+  Object.freeze(value.words);
+  return Object.freeze(value);
