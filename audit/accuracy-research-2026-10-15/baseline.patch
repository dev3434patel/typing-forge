+    return await response.json() as { access_token: string; user: { id: string } };
+  };
+  const host = await signIn(firstEmail!, firstPassword!), outsider = await signIn(secondEmail!, secondPassword!);
+  expect(host.user.id).not.toBe(outsider.user.id);
+  const headers = (token: string) => ({ apikey: key!, Authorization: `Bearer ${token}` });
+  const created = await request.post(`${url}/rest/v1/rpc/forge_create_race`, { headers: headers(host.access_token), data: { p_duration: 15 } });
