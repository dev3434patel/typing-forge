+    expect(outsiderRead.status()).toBe(403);
+    const forgedWrite = await request.patch(`${url}/rest/v1/race_sessions?id=eq.${room.id}`, { headers: headers(host.access_token), data: { status: 'completed', winner_id: host.user.id, host_progress: 100, host_wpm: 9999 } });
+    expect(forgedWrite.status()).toBe(403);
+    const joined = await request.post(`${url}/rest/v1/rpc/forge_join_race`, { headers: headers(outsider.access_token), data: { p_code: room.room_code } });
+    expect(joined.ok()).toBe(true);
+    const joinedRoom = await joined.json() as { opponent_id: string; status: string; started_at: string; deadline_at: string; version: number };
