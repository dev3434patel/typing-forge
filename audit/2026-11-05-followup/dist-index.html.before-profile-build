    <style>
      html,
      body {
        margin: 0;
        background: #07070a;
      }
      .first-paint {
        position: fixed;
        inset: 0;
        min-height: 100svh;
        background: #07070a;
      }
      .first-paint-caret {
        position: absolute;
        top: 46%;
        left: 50%;
        display: block;
        width: 2px;
        height: 56px;
        background: #c6ff3d;
        transform: translate(-50%, -50%);
        animation: first-paint-blink 1s steps(1) infinite;
      }
      .first-paint-title {
        position: absolute;
        top: 64%;
        left: 50%;
        display: inline-flex;
        transform: translateX(-50%);
        color: #77778f;
        font:
          700 clamp(48px, 9vw, 128px)/1.1 Sora,
          "Sora Fallback",
          "Inter Variable",
          sans-serif;
        letter-spacing: -0.04em;
        white-space: nowrap;
        text-shadow:
          0 1px 0 #ffffff08,
          0 -1px 0 #000;
        -webkit-font-smoothing: antialiased;
      }
      .first-paint-label {
        position: absolute;
        inset: auto 24px 32px;
        color: #8b8ba0;
        font:
          400 12px Sora,
          sans-serif;
        text-align: center;
      }
      .workspace-loading {
        box-sizing: border-box;
        min-height: 100svh;
        margin: 0;
        padding: 24px;
        display: grid;
        place-items: center;
        background: #07070a;
        color: #ededf2;
        font:
          400 14px Sora,
          sans-serif;
      }
      @keyframes first-paint-blink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .first-paint-caret {
          animation: none;
        }
      }
      @media (max-height: 500px) {
        .first-paint-title {
          top: 56%;
          font-size: 48px;
        }
      }
