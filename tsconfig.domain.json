{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": [
    "src/domain/**/*.ts",
    "src/games/engine/*.ts",
    "src/games/modes/*.ts",
    "src/lib/content-policy.ts",
    "src/lib/practice-style.ts",
    "src/lib/typing-core/*.ts",
    "src/lib/session-diagnostics.ts",
    "src/lib/typing-feedback.ts",
    "src/lib/typing-passage.ts",
    "src/lib/race-pace.ts",
    "src/lib/keyboard-lab.ts",
    "src/lib/learning-evidence.ts",
    "src/lib/keybr-engine.ts",
    "src/lib/content-packs.ts",
    "src/lib/content-library.ts",
    "src/lib/quotes.ts",
    "src/lib/bot-engine.ts",
    "src/lib/metrics-engine.ts",
    "src/lib/stats-utils.ts",
    "src/services/history-model.ts",
    "src/services/session-repository.ts",
    "src/services/session-sync.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
